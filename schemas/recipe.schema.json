{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Haze-dev1/Olympus/schemas/recipe.schema.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]{0,30}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "harness",
        "coding-agent",
        "app"
      ]
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "resources": {
      "type": "object",
      "properties": {
        "min_ram": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "user": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "writable": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "build": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1
        },
        "dst": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "src",
        "dst"
      ],
      "additionalProperties": false
    },
    "volumes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      },
      "uniqueItems": true
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "health": {
      "type": "object",
      "properties": {
        "http": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "port",
            "path"
          ],
          "additionalProperties": false
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "timeout": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "secrets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "env": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "required": [
          "env"
        ],
        "additionalProperties": false
      }
    },
    "supports": {
      "type": "object",
      "properties": {
        "mcps": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "type": "string",
              "enum": [
                "yaml",
                "toml",
                "json"
              ]
            },
            "style": {
              "type": "string",
              "enum": [
                "hermes",
                "codex",
                "opencode"
              ]
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "file",
            "format",
            "style",
            "key"
          ],
          "additionalProperties": false
        },
        "skills": {
          "type": "object",
          "properties": {
            "dir": {
              "type": "string",
              "minLength": 1
            },
            "mode": {
              "type": "string",
              "enum": [
                "copy",
                "mount"
              ]
            }
          },
          "required": [
            "dir",
            "mode"
          ],
          "additionalProperties": false
        },
        "channels": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                }
              }
            },
            "required": [
              "env"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "src": {
            "type": "string",
            "minLength": 1
          },
          "dst": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "src",
          "dst"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "hooks": {
      "type": "object",
      "properties": {
        "post_install": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "kind",
    "image"
  ],
  "additionalProperties": false
}
