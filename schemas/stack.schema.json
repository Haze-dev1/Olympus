{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Haze-dev1/Olympus/schemas/stack.schema.json",
  "type": "object",
  "properties": {
    "inputs": {
      "type": "object",
      "properties": {
        "recipes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "server": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "ssh_key": {
          "type": "string",
          "minLength": 1
        },
        "keep": {
          "type": "integer",
          "minimum": 1
        },
        "confirm_timeout": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "host"
      ],
      "additionalProperties": false
    },
    "mcps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "x-secret": true
            }
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "x-secret": true
            }
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "agents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "recipe": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]{0,30}$"
          },
          "image_tag": {
            "type": "string",
            "minLength": 1
          },
          "mcps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "skills": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "all"
                ]
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            ]
          },
          "secrets": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "x-secret": true
            }
          },
          "channels": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "token": {
                  "type": "string",
                  "minLength": 1,
                  "x-secret": true
                },
                "allow": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "minItems": 1
                }
              },
              "required": [
                "token",
                "allow"
              ],
              "additionalProperties": false
            }
          },
          "ports": {
            "type": "object",
            "properties": {
              "public": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "uniqueItems": true
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "recipe"
        ],
        "additionalProperties": false
      }
    },
    "apps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "recipe": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]{0,30}$"
          },
          "image_tag": {
            "type": "string",
            "minLength": 1
          },
          "mcps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "skills": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "all"
                ]
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            ]
          },
          "secrets": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "x-secret": true
            }
          },
          "channels": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "token": {
                  "type": "string",
                  "minLength": 1,
                  "x-secret": true
                },
                "allow": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "minItems": 1
                }
              },
              "required": [
                "token",
                "allow"
              ],
              "additionalProperties": false
            }
          },
          "ports": {
            "type": "object",
            "properties": {
              "public": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "uniqueItems": true
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "recipe"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "server"
  ],
  "additionalProperties": false
}
